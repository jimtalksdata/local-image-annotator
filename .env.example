# All optional — the backend has working defaults.

# Where model weights live (default: <project>/models/vlm)
# ANNOTATOR_MODELS_DIR=F:\Projects\stable_diffusion\models\vlm

# Allow the backend to download missing weights from Hugging Face (default: off)
# ANNOTATOR_ALLOW_DOWNLOAD=1

# Backend bind address. Keep it on loopback: there is no auth and the API can
# read and write arbitrary paths on this machine.
# ANNOTATOR_HOST=127.0.0.1
# ANNOTATOR_PORT=8077

# Restrict which folders the API may read/write (';'-separated). Required if you
# ever bind to a non-loopback address.
# ANNOTATOR_ALLOWED_ROOTS=F:\Projects\stable_diffusion\images;F:\datasets
